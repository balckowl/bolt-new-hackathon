		"lib": "@/src/lib",
		"tiptapExtensions": "@src/components/tiptap-extensions",
		"tiptapNodes": "@/src/components/tiptap-node",
		"tiptapUi": "@/src/components/tiptap-ui",
		"tiptapUiPrimitives": "@/src/components/tiptap-ui-primitive",
		"tiptapUtils": "@/src/components/tiptap-utils",
		"styles": "@/src/components/tiptap-ui-primitive/styles",
		"utils": "@/src/lib/utils",
		"ui": "@/src/components/ui"
